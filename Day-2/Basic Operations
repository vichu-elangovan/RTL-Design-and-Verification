module operators;

reg [3:0] A,B;

initial begin

    A = 4'b1010;   // 10
    B = 4'b0011;   // 3

    $display("A = %b",A);
    $display("B = %b",B);

    // Arithmetic Operators
    $display("\nArithmetic Operators");
    $display("A+B = %d",A+B);
    $display("A-B = %d",A-B);
    $display("A*B = %d",A*B);
    $display("A/B = %d",A/B);
    $display("A%%B = %d",A%B);

    // Relational Operators
    $display("\nRelational Operators");
    $display("A>B  = %b",A>B);
    $display("A<B  = %b",A<B);
    $display("A>=B = %b",A>=B);
    $display("A<=B = %b",A<=B);
    $display("A==B = %b",A==B);
    $display("A!=B = %b",A!=B);

    // Logical Operators
    $display("\nLogical Operators");
    $display("A&&B = %b",A&&B);
    $display("A||B = %b",A||B);
    $display("!A   = %b",!A);

    // Bitwise Operators
    $display("\nBitwise Operators");
    $display("A&B = %b",A&B);
    $display("A|B = %b",A|B);
    $display("A^B = %b",A^B);
    $display("~A  = %b",~A);

    // Shift Operators
    $display("\nShift Operators");
    $display("A<<1 = %b",A<<1);
    $display("A>>1 = %b",A>>1);

    // Concatenation
    $display("\nConcatenation");
    $display("{A,B} = %b",{A,B});

    // Replication
    $display("\nReplication");
    $display("{4{1'b1}} = %b",{4{1'b1}});

    $finish;

end




