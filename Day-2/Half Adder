Design code 

1.Dataflow
module halfadder_dataflow(
    input A,
    input B,
    output Sum,
    output Carry
);

assign Sum   = A ^ B;
assign Carry = A & B;

endmodule

2.Structural Fow

module halfadder_structural(
    input A,
    input B,
    output Sum,
    output Carry
);

xor G1(Sum, A, B);
and G2(Carry, A, B);

endmodule

3.Behavioral Flow

module halfadder_behavioral(
    input A,
    input B,
    output reg Sum,
    output reg Carry
);

always @(*) begin
    Sum   = A ^ B;
    Carry = A & B;
end

endmodule



