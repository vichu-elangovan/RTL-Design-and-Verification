module test;

reg A,B;

wire AND_Y;
wire OR_Y;
wire NAND_Y;
wire NOR_Y;
wire XOR_Y;
wire XNOR_Y;

gates_using_mux uut(
    .A(A),
    .B(B),
    .AND_Y(AND_Y),
    .OR_Y(OR_Y),
    .NAND_Y(NAND_Y),
    .NOR_Y(NOR_Y),
    .XOR_Y(XOR_Y),
    .XNOR_Y(XNOR_Y)
);

initial begin

    $dumpfile("dump.vcd");
    $dumpvars(0,test);

    $display("A B | AND OR NAND NOR XOR XNOR");

    $monitor("%b %b |  %b   %b    %b    %b   %b    %b",
              A,B,
              AND_Y,
              OR_Y,
              NAND_Y,
              NOR_Y,
              XOR_Y,
              XNOR_Y);

    A=0; B=0; #10;
    A=0; B=1; #10;
    A=1; B=0; #10;
    A=1; B=1; #10;

    $finish;

end

endmodule

