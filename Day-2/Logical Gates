Design Code

module gates_using_mux(
    input A,
    input B,

    output AND_Y,
    output OR_Y,
    output NAND_Y,
    output NOR_Y,
    output XOR_Y,
    output XNOR_Y
);

assign AND_Y  = A ? B   : 1'b0;
assign OR_Y   = A ? 1'b1: B;
assign NAND_Y = A ? ~B  : 1'b1;
assign NOR_Y  = A ? 1'b0: ~B;
assign XOR_Y  = A ? ~B  : B;
assign XNOR_Y = A ? B   : ~B;

endmodule

